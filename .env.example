# Postgres holding tenant config. Use the POOLED connection string, with sslmode=require, and
# percent-encode the password (a `$` would be mangled by compose).
ORCA_DATABASE_URL=
# Schema on that database. Defaults to `orca_gw` (stage). Prod uses `orca_gw_prod` -- same
# project, own schema, so stage and prod never share tenant config, kill switches or call
# records (P2 brief D2). A plain lowercase identifier, validated at startup.
ORCA_DB_SCHEMA=orca_gw

# How long a tenant-config edit may take to be seen unless the cache is invalidated explicitly.
ORCA_TENANT_CACHE_TTL_S=15

# Voice channel adapter (POST /chat/completions). The route fails closed (503) if the secret is
# unset. Which tenant a request is for comes from the X-Orca-Tenant header, never from here.
ORCA_VOICE_SHARED_SECRET=
# Wait this long for newer speech-recognition hypotheses before calling the backend.
ORCA_VOICE_DEBOUNCE_MS=300
# Max backend runs in flight across ALL tenants and BOTH channels (voice and chat share this one
# ceiling -- P3 brief A1/D2). Do not raise while the backend's pool is shared.
ORCA_VOICE_MAX_CONCURRENT_RUNS=1
ORCA_VOICE_RUN_TIMEOUT_S=25.0

# Console (/console/*). ONE shared secret, exchanged at /console/login for a signed session
# cookie -- no user accounts. Also signs the cookie itself. The route fails closed (never 200)
# if unset. Rotate by changing this value; every existing session is invalidated immediately.
ORCA_CONSOLE_SECRET=
# How long a session cookie is valid for.
ORCA_CONSOLE_SESSION_TTL_S=43200
# {conversation_id} is substituted for panel 2's outbound link to the ElevenLabs dashboard.
ORCA_CONSOLE_ELEVENLABS_CONVERSATION_URL=https://elevenlabs.io/app/conversational-ai/history?conversation={conversation_id}

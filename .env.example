# Base URL of the Zunkiree backend the ZunkireeAgentBackend adapter calls.
ORCA_ZUNKIREE_BASE_URL=https://staging-api.zunkireelabs.com

# JSON object mapping our `tenant` id -> the backend's own tenant key
# (Zunkiree's site_id). This is the only place that key may appear.
ORCA_ZUNKIREE_TENANT_KEYS={}

# Voice channel adapter (POST /chat/completions). All required; the route fails closed
# (503) if the tenant or secret is unset. Paste the secret into the voice platform's
# "API Key" field -- the platform sends an Authorization header regardless, so only the
# VALUE is checked.
ORCA_VOICE_TENANT=
ORCA_VOICE_AGENT_ID=default
ORCA_VOICE_SHARED_SECRET=
# Wait this long for newer speech-recognition hypotheses before calling the backend.
ORCA_VOICE_DEBOUNCE_MS=300
